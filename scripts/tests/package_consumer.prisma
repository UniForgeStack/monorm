datasource db { provider = "__DIALECT__" }
model Base {
  id Int @id
  @@inherit.abstract
  @@timestamps.updated_at("changed", mode: "application")
  @@soft_delete.deleted_at("deleted", mode: "application")
  @@locking.version("version")
}
model Note {
  text String
  start Int
  end Int
  shop_id Int
  updated_by String?
  note Json? @outside.wrapped("w:")
  first String @default("")
  last String @default("")
  slug String?
  stamp String?
  editor String?
  region String?
  owner String?
  touched_by String?
  secret String
  @@inherit.extends(Base)
  @@outside.tag("installed")
  @@query.filter("positive", "id > 0")
  @@outside.guard
  @@map("pkg1d_seam_notes")
}
