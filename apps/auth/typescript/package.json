{
  "name": "@ufstack/monorm-auth",
  "version": "0.1.0",
  "description": "Users, roles, permissions and passwords for the monorm package: one schema, no native code",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./queries.js": {
      "types": "./dist/src/queries.d.ts",
      "default": "./dist/src/queries.js"
    },
    "./methods.js": {
      "types": "./dist/src/methods.d.ts",
      "default": "./dist/src/methods.js"
    },
    "./schema.prisma": "./schema.prisma",
    "./package.json": "./package.json"
  },
  "monorm": {
    "app": "./schema.prisma"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "test:bun": "bun test ./test/"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.0"
  },
  "peerDependencies": {
    "@ufstack/monorm": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@ufstack/monorm": "file:../../../languages/js",
    "typescript": "^5.9.0",
    "@ufstack/monorm-timestamps": "file:../../../target/extension-packages/timestamps/npm",
    "@ufstack/monorm-soft-delete": "file:../../../target/extension-packages/soft-delete/npm",
    "@ufstack/monorm-locking": "file:../../../target/extension-packages/locking/npm",
    "@ufstack/monorm-inherit": "file:../../../target/extension-packages/inherit/npm"
  },
  "files": [
    "dist/src",
    "schema.prisma"
  ]
}
