@@ -0,0 +1,85 @@
+// The IMDBench Postgres schema (`_postgres/schema.sql`) for MonOrm.
+// It maps to the same tables as the `_postgres`, `_prisma` and `_drizzle` contenders,
+// so the same data load serves MonOrm. Python and JS read this one file.
+// The SQL functions `full_name()` and `avg_rating()` are not used: the queries build both.
+
+datasource db {
+  provider = "postgresql"
+}
+
+model Movie {
+  id          Int        @id @default(autoincrement())
+  image       String
+  title       String
+  year        Int
+  description String
+  directors   Director[]
+  cast        Actor[]
+  reviews     Review[]
+
+  @@map("movies")
+}
+
+model User {
+  id      Int      @id @default(autoincrement())
+  name    String
+  image   String
+  reviews Review[]
+
+  @@map("users")
+}
+
+model Person {
+  id          Int        @id @default(autoincrement())
+  first_name  String
+  middle_name String     @default("")
+  last_name   String
+  image       String
+  bio         String
+  acted_in    Actor[]
+  directed    Director[]
+
+  @@map("persons")
+}
+
+model Director {
+  id         Int    @id @default(autoincrement())
+  list_order Int?
+  person_id  Int
+  movie_id   Int
+  person     Person @relation(fields: [person_id], references: [id])
+  movie      Movie  @relation(fields: [movie_id], references: [id])
+
+  @@index([person_id])
+  @@index([movie_id])
+  @@map("directors")
+}
+
+model Actor {
+  id         Int    @id @default(autoincrement())
+  list_order Int?
+  person_id  Int
+  movie_id   Int
+  person     Person @relation(fields: [person_id], references: [id])
+  movie      Movie  @relation(fields: [movie_id], references: [id])
+
+  @@index([person_id])
+  @@index([movie_id])
+  @@map("actors")
+}
+
+model Review {
+  id            Int      @id @default(autoincrement())
+  body          String
+  rating        Int
+  creation_time DateTime
+  author_id     Int
+  movie_id      Int
+  author        User     @relation(fields: [author_id], references: [id])
+  movie         Movie    @relation(fields: [movie_id], references: [id])
+
+  @@index([author_id])
+  @@index([movie_id])
+  @@index([creation_time])
+  @@map("reviews")
+}
