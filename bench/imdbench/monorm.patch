diff --git a/_monorm/tools/check_results.py b/_monorm/tools/check_results.py
new file mode 100644
index 0000000..e828726
--- /dev/null
+++ b/_monorm/tools/check_results.py
@@ -0,0 +1,282 @@
+"""Compare the MonOrm results with the SQLAlchemy and Prisma results for the same ids.
+
+  PYTHONPATH=_monorm/tools/local_patch IMDBENCH_MONORM_URL=postgres://... venv/bin/python _monorm/tools/check_results.py
+
+IMDBench has no result check of its own.
+The script runs all 7 queries on the contenders and exits with 1 on the first mismatch it finds in any query.
+Ids, timings and random numbers in names are ignored; other numbers are compared as numbers.
+Run `load_local.py` first. The database must have no leftovers of an earlier run.
+"""
+import asyncio
+import json
+import math
+import os
+import pathlib
+import re
+import subprocess
+import sys
+import types
+
+import asyncpg
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+
+DB_URL = os.environ.get("IMDBENCH_CHECK_URL", "postgresql://postgres:postgres@localhost:55432/imdb_bench")
+os.environ.setdefault("IMDBENCH_MONORM_URL", DB_URL.replace("postgresql://", "postgres://"))
+os.environ.setdefault("DATABASE_URL", DB_URL + "?schema=public&connection_limit=4")
+
+import _sqlalchemy.queries_asyncio as sa_q  # noqa: E402
+import _monorm.queries as mo_q  # noqa: E402
+
+CTX = types.SimpleNamespace(db_host="localhost", pg_port=55432, concurrency=4, async_split=1, number_of_ids=10)
+PREFIX = "insert_test__"
+READS = ["get_user", "get_movie", "get_person"]
+WRITES = ["update_movie", "insert_user", "insert_movie", "insert_movie_plus"]
+
+
+# Where each result field holds an id, so the ids of SQLAlchemy (other id space) map to the public ones.
+ID_KINDS = {
+    "get_user": ("user", {"latest_reviews": ("review", {"movie": ("movie", {})})}),
+    "get_movie": (
+        "movie",
+        {
+            "directors": ("person", {}),
+            "cast": ("person", {}),
+            "reviews": ("review", {"author": ("user", {})}),
+        },
+    ),
+    "get_person": ("person", {"acted_in": ("movie", {}), "directed": ("movie", {})}),
+    "update_movie": ("movie", {}),
+    # The new movie has no counterpart, so only its people map.
+    "insert_movie": (None, {"directors": ("person", {}), "cast": ("person", {})}),
+}
+
+
+def remap(node, spec, table):
+    kind, children = spec
+    if kind:
+        node["id"] = table[kind][node["id"]]
+    for field, child in children.items():
+        v = node[field]
+        for item in v if isinstance(v, list) else [v]:
+            remap(item, child, table)
+
+
+def close_enough(a, b):
+    if isinstance(a, bool) or isinstance(b, bool):
+        return a is b
+    if isinstance(a, (int, float)) and isinstance(b, (int, float)):
+        return math.isclose(a, b, rel_tol=1e-9, abs_tol=1e-9)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(close_enough(a[k], b[k]) for k in a)
+    if isinstance(a, list) and isinstance(b, list):
+        return len(a) == len(b) and all(close_enough(x, y) for x, y in zip(a, b))
+    return a == b
+
+
+def same_user_unordered(a, b):
+    """The SQLAlchemy get_user has no ORDER BY, so it returns any 10 reviews of the user in table order.
+
+    Equal user fields and review count must hold. With fewer than 10 reviews the sets must be equal.
+    With 10 the SQLAlchemy set can be a cut of a longer list, so only the reviews in both sets must be equal.
+    """
+    ra, rb = {r["id"]: r for r in a["latest_reviews"]}, {r["id"]: r for r in b["latest_reviews"]}
+    head = lambda u: {k: v for k, v in u.items() if k != "latest_reviews"}
+    if not close_enough(head(a), head(b)) or len(ra) != len(rb):
+        return False
+    if len(ra) < 10:
+        return close_enough(ra, rb)
+    return all(close_enough(ra[i], rb[i]) for i in ra.keys() & rb.keys())
+
+
+def norm(query, value, skip_images=False):
+    """Drop what differs by design: new ids and the random numbers in names."""
+    if query == "update_movie":
+        # The suffix holds the movie id, and the id spaces differ.
+        return {
+            "title": re.sub(r"---\d+$", "", value["title"]),
+            "suffix_ok": value["title"].endswith(f"---{str(value['id'])[:8]}"),
+        }
+    if query in READS:
+        return value
+
+    def walk(v, top, key=None):
+        if isinstance(v, dict):
+            drop = {"id"} if top or query == "insert_movie_plus" else set()
+            if query == "insert_user" and skip_images:
+                drop.add("image")
+            return {k: walk(x, False, k) for k, x in v.items() if k not in drop}
+        if isinstance(v, list):
+            return [walk(x, False, key) for x in v]
+        if isinstance(v, str):
+            return re.sub(r"\d+", "#", v)
+        if key == "year":
+            return "#"
+        return v
+
+    return walk(value, True)
+
+
+async def run_python(mod, ids, updates, people):
+    conn = await mod.connect(CTX)
+    out = {}
+    try:
+        for q in READS:
+            out[q] = [{"arg": i, "result": json.loads(await getattr(mod, q)(conn, i))} for i in ids[q]]
+        out["update_movie"] = [
+            {"arg": u["id"], "result": json.loads(await mod.update_movie(conn, u["id"]))} for u in updates
+        ]
+        stubs = {
+            "insert_user": PREFIX,
+            "insert_movie": {"prefix": PREFIX, "people": people},
+            "insert_movie_plus": PREFIX,
+        }
+        for q, stub in stubs.items():
+            out[q] = [{"arg": None, "result": json.loads(await getattr(mod, q)(conn, stub))}]
+    finally:
+        await mod.close(CTX, conn)
+    return out
+
+
+async def reset():
+    conn = await mod_conn()
+    try:
+        for q in WRITES:
+            await mo_q.setup(CTX, conn, q)
+    finally:
+        await mo_q.close(CTX, conn)
+    await reset_sa()
+
+
+async def reset_sa():
+    # The SQLAlchemy contender has no setup for these queries and writes to schema `sa`.
+    c = await asyncpg.connect(DB_URL)
+    try:
+        async with c.transaction():
+            like = PREFIX + "%"
+            await c.execute("update sa.movie set title = regexp_replace(title, '---[0-9]+$', '') where title like '%---%'")
+            for tbl in ("directors", '"cast"'):
+                await c.execute(
+                    f"delete from sa.{tbl} where movie_id in (select id from sa.movie where image like $1)"
+                    f" or person_id in (select id from sa.person where image like $1)",
+                    like,
+                )
+            await c.execute("delete from sa.movie where image like $1", like)
+            await c.execute("delete from sa.person where image like $1", like)
+            await c.execute('delete from sa."user" where name like $1', like)
+    finally:
+        await c.close()
+
+
+async def mod_conn():
+    return await mo_q.connect(CTX)
+
+
+async def leftovers():
+    c = await asyncpg.connect(DB_URL)
+    try:
+        return {
+            "titles with suffix": await c.fetchval("select count(*) from movies where title like '%---%'"),
+            "test movies": await c.fetchval("select count(*) from movies where image like $1", PREFIX + "%"),
+            "test persons": await c.fetchval("select count(*) from persons where image like $1", PREFIX + "%"),
+            "test users": await c.fetchval("select count(*) from users where name like $1", PREFIX + "%"),
+            "sa titles with suffix": await c.fetchval("select count(*) from sa.movie where title like '%---%'"),
+            "sa test movies": await c.fetchval("select count(*) from sa.movie where image like $1", PREFIX + "%"),
+            "sa test persons": await c.fetchval("select count(*) from sa.person where image like $1", PREFIX + "%"),
+            "sa test users": await c.fetchval('select count(*) from sa."user" where name like $1', PREFIX + "%"),
+        }
+    finally:
+        await c.close()
+
+
+async def main():
+    pre = await leftovers()
+    if any(pre.values()):
+        sys.exit(f"The database has leftovers of an earlier run: {pre}")
+    c = await asyncpg.connect(DB_URL)
+    ids = {
+        "get_user": [r[0] for r in await c.fetch("select id from users order by id")],
+        "get_movie": [r[0] for r in await c.fetch("select id from movies order by id")],
+        "get_person": [r[0] for r in await c.fetch("select id from persons order by id")],
+    }
+    updates = [dict(r) for r in await c.fetch("select id, title from movies order by id limit 5")]
+    people = [r[0] for r in await c.fetch("select id from persons order by id limit 4")]
+    await c.close()
+
+    # The SQLAlchemy loader gives other ids, so the entities are paired by a unique natural key.
+    tables = {
+        "user": ("users", "image", '"user"'),
+        "movie": ("movies", "image", "movie"),
+        "person": ("persons", "image", "person"),
+        "review": ("reviews", "body", "review"),
+    }
+    pub2sa, sa2pub = {}, {}
+    c = await asyncpg.connect(DB_URL)
+    for kind, (pub_table, col, sa_table) in tables.items():
+        sa_by_key = {r["k"]: r["id"] for r in await c.fetch(f"select id, {col} as k from sa.{sa_table}")}
+        pub2sa[kind] = {r["id"]: sa_by_key[r["k"]] for r in await c.fetch(f"select id, {col} as k from {pub_table}")}
+        sa2pub[kind] = {v: k for k, v in pub2sa[kind].items()}
+    await c.close()
+    sa_ids = {
+        "get_user": [pub2sa["user"][i] for i in ids["get_user"]],
+        "get_movie": [pub2sa["movie"][i] for i in ids["get_movie"]],
+        "get_person": [pub2sa["person"][i] for i in ids["get_person"]],
+    }
+    sa_updates = [{"id": pub2sa["movie"][u["id"]]} for u in updates]
+    sa_people = [pub2sa["person"][i] for i in people]
+
+    results = {}
+    results["sqlalchemy"] = await run_python(sa_q, sa_ids, sa_updates, sa_people)
+    for q, entries in results["sqlalchemy"].items():
+        if q in ID_KINDS:
+            for e in entries:
+                # update_movie keeps its own id, because the title suffix holds it.
+                if q != "update_movie":
+                    remap(e["result"], ID_KINDS[q], sa2pub)
+    await reset()
+    results["monorm_py"] = await run_python(mo_q, ids, updates, people)
+    await reset()
+    proc = subprocess.run(
+        ["node", str(ROOT / "_monorm/tools/node_results.mjs")],
+        input=json.dumps({"reads": ids, "updates": updates, "people": people}),
+        capture_output=True, text=True, cwd=ROOT,
+    )
+    if proc.returncode:
+        sys.exit(f"node_results.mjs failed:\n{proc.stderr[-2000:]}")
+    results.update(json.loads(proc.stdout.strip().splitlines()[-1]))
+    await reset()
+
+    failed = 0
+    pairs = [("monorm_py", "sqlalchemy"), ("monorm_py", "prisma"), ("monorm_js", "monorm_py")]
+    print(f"{'query':<20}" + "".join(f"{a + ' vs ' + b:<30}" for a, b in pairs))
+    for q in READS + WRITES:
+        cells = []
+        for a, b in pairs:
+            ra, rb = results[a][q], results[b][q]
+            bad = 0
+            for x, y in zip(ra, rb):
+                # SQLAlchemy and MonOrm name the image of a new user alike; Prisma uses another pattern.
+                skip = q == "insert_user" and "prisma" in (a, b)
+                if q == "get_user" and "sqlalchemy" in (a, b):
+                    same = same_user_unordered(x["result"], y["result"])
+                else:
+                    same = close_enough(norm(q, x["result"], skip), norm(q, y["result"], skip))
+                if not same:
+                    bad += 1
+                    if bad == 1:
+                        print(f"MISMATCH {q} {a} vs {b} arg={x['arg']}\n  {a}: {json.dumps(x['result'])[:600]}\n  {b}: {json.dumps(y['result'])[:600]}")
+            if len(ra) != len(rb):
+                bad += 1
+            cells.append(f"{'ok' if not bad else 'FAIL'} ({len(ra) - bad}/{len(ra)})")
+            failed += bool(bad)
+        print(f"{q:<20}" + "".join(f"{c:<30}" for c in cells))
+
+    post = await leftovers()
+    print("leftovers after the run:", post)
+    failed += any(post.values())
+    print("RESULT:", "FAIL" if failed else "PASS")
+    sys.exit(1 if failed else 0)
+
+
+asyncio.run(main())
