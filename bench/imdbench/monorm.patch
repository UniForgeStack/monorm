+"""Load dataset.json into a local Postgres without Docker.
+
+Reuses the `_postgres` and `_sqlalchemy` loaders unchanged and only
+redirects their hard-coded connection settings.
+
+  python _monorm/tools/load_local.py --port 55432 --database imdb_bench
+
+The tables of the `_postgres` contenders go to schema `public`.
+The tables of the `_sqlalchemy` contender go to schema `sa` of the same database,
+so one database serves all the contenders.
+"""
+import argparse
+import asyncio
+import pathlib
+import runpy
+import subprocess
+import sys
+
+import asyncpg
+import sqlalchemy as sa
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+
+p = argparse.ArgumentParser()
+p.add_argument('--host', default='localhost')
+p.add_argument('--port', type=int, default=55432)
+p.add_argument('--superuser', default='postgres:postgres')
+p.add_argument('--database', required=True)
+p.add_argument('--dataset', default=str(ROOT / 'dataset/build/dataset.json'))
+args = p.parse_args()
+su, pw = args.superuser.split(':')
+base_url = f'postgresql://{su}:{pw}@{args.host}:{args.port}'
+
+
+def psql(db, *extra):
+    subprocess.run(
+        ['psql', f'{base_url}/{db}', '-v', 'ON_ERROR_STOP=1', '-q', *extra],
+        check=True, stdout=subprocess.DEVNULL)
+
+
+psql('postgres', '-c', f'DROP DATABASE IF EXISTS {args.database} WITH (FORCE)')
+psql('postgres', '-c', f'CREATE DATABASE {args.database}')
+psql(args.database, '-c', 'CREATE SCHEMA sa',
+     '-f', str(ROOT / '_postgres/schema.sql'))
+
+real_connect = asyncpg.connect
+
+
+def connect(*a, **kw):
+    kw.update(user=su, password=pw, database=args.database,
+              host=args.host, port=args.port)
+    return real_connect(*a, **kw)
+
+
+asyncpg.connect = connect
+sys.argv = ['loaddata.py', args.dataset]
+runpy.run_path(str(ROOT / '_postgres/loaddata.py'), run_name='__main__')
+asyncpg.connect = real_connect
+
+# The async_fallback dialect needs a current loop, and asyncio.run closed the last one.
+asyncio.set_event_loop(asyncio.new_event_loop())
+
+import _sqlalchemy.models as m  # noqa: E402
+from _sqlalchemy.loaddata import load_data  # noqa: E402
+
+engine = sa.create_engine(
+    f'postgresql+asyncpg://{su}:{pw}@{args.host}:{args.port}/{args.database}'
+    '?async_fallback=True',
+    connect_args={'server_settings': {'search_path': 'sa'}})
+# alembic's env.py has no URL for this host, so create the tables directly.
+m.Base.metadata.create_all(engine)
+load_data(args.dataset, engine)
