+"""Point the SQLAlchemy contender at the local database `load_local.py` filled.
+
+That contender hard-codes its role and database name.
+Put this directory on PYTHONPATH: the spawned worker processes of
+bench_python.py then apply the patch too.
+
+  PYTHONPATH=_monorm/tools/local_patch python bench_python.py sqlalchemy_asyncio --pg-port 55432
+"""
+import os
+
+try:
+    import sqlalchemy.ext.asyncio as _sa_asyncio
+except ImportError:
+    _sa_asyncio = None
+
+if _sa_asyncio is not None:
+    _create = _sa_asyncio.create_async_engine
+
+    def _create_local(url, **kw):
+        host_port = str(url).split('@')[1].split('/')[0]
+        db = os.environ.get('IMDBENCH_LOCAL_DB', 'imdb_bench')
+        auth = os.environ.get('IMDBENCH_LOCAL_AUTH', 'postgres:postgres')
+        kw['connect_args'] = {'server_settings': {'search_path': 'sa'}}
+        return _create(f'postgresql+asyncpg://{auth}@{host_port}/{db}', **kw)
+
+    _sa_asyncio.create_async_engine = _create_local
diff --git a/_monorm/tools/node_results.mjs b/_monorm/tools/node_results.mjs
new file mode 100644
index 0000000..154c577
--- /dev/null
+++ b/_monorm/tools/node_results.mjs
@@ -0,0 +1,55 @@
+// Runs the Prisma and MonOrm (Node.js) contenders on given ids and prints their parsed results.
+// Input on stdin: {reads, updates, people}. Output: {prisma, monorm_js}, each query -> [{arg, result}].
+import { readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+const require = createRequire(path.join(root, "jsbench.js"));
+const input = JSON.parse(readFileSync(0, "utf8"));
+
+const { TunedApp } = require("./_prisma/index.js");
+const { App } = await import(path.join(root, "_monorm/index.mjs"));
+
+const monorm = new App({ max: 4 });
+await monorm.init();
+const prisma = new TunedApp();
+
+const MUTATIONS = ["update_movie", "insert_user", "insert_movie", "insert_movie_plus"];
+const resetAll = async () => {
+  for (const q of MUTATIONS) await monorm.setup(q);
+};
+
+async function runAll(app, mapUpdate) {
+  const out = {};
+  for (const q of ["get_user", "get_movie", "get_person"]) {
+    out[q] = [];
+    for (const id of input.reads[q]) out[q].push({ arg: id, result: JSON.parse(await app.benchQuery(q, id)) });
+  }
+  out.update_movie = [];
+  for (const u of input.updates) {
+    out.update_movie.push({ arg: u.id, result: JSON.parse(await app.benchQuery("update_movie", mapUpdate(u))) });
+  }
+  const stubs = {
+    insert_user: "insert_test__",
+    insert_movie: { prefix: "insert_test__", people: input.people },
+    insert_movie_plus: "insert_test__",
+  };
+  for (const [q, stub] of Object.entries(stubs)) {
+    out[q] = [{ arg: null, result: JSON.parse(await app.benchQuery(q, stub)) }];
+  }
+  return out;
+}
+
+await resetAll();
+const result = {};
+// Prisma sets the title it is given, and MonOrm appends a suffix to the title.
+result.prisma = await runAll(prisma, (u) => ({ id: u.id, title: u.title + "---" + u.id }));
+await resetAll();
+result.monorm_js = await runAll(monorm, (u) => u.id);
+await resetAll();
+
+await prisma.$disconnect();
+await monorm.close();
+console.log(JSON.stringify(result));
