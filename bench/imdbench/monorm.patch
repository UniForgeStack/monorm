diff --git a/_monorm/queries.py b/_monorm/queries.py
new file mode 100644
index 0000000..342b596
--- /dev/null
+++ b/_monorm/queries.py
@@ -0,0 +1,279 @@
+import asyncio
+import json
+import os
+import pathlib
+import random
+
+from _monorm._orm import func, orm
+
+ASYNC = True
+INSERT_PREFIX = "insert_test__"
+
+_models = orm.loads((pathlib.Path(__file__).parent / "schema.prisma").read_text())
+Movie, Person, User = _models["Movie"], _models["Person"], _models["User"]
+Director, Actor, Review = _models["Director"], _models["Actor"], _models["Review"]
+
+# One pool per process: the harness calls connect() and close() once per task.
+_pool = None
+_refs = 0
+
+
+def _url(ctx):
+    # The default matches the database of the `_postgres` contenders; the env var points a local run elsewhere.
+    return os.environ.get("IMDBENCH_MONORM_URL") or (
+        f"postgres://postgres_bench:edgedbbenchmark@{ctx.db_host}:{ctx.pg_port}/postgres_bench"
+    )
+
+
+async def connect(ctx):
+    global _pool, _refs
+    _refs += 1
+    try:
+        if _pool is None:
+            size = max(1, ctx.concurrency // ctx.async_split)
+            _pool = asyncio.ensure_future(orm.connect(_url(ctx), max_connections=size))
+        return await _pool
+    except BaseException:
+        _refs -= 1
+        _pool = None
+        raise
+
+
+async def close(ctx, db):
+    global _pool, _refs
+    _refs -= 1
+    if _refs <= 0 and _pool is not None:
+        pool, _pool, _refs = _pool, None, 0
+        await (await pool).close()
+
+
+def _full_name(p):
+    mid = f" {p.middle_name}" if p.middle_name else ""
+    return f"{p.first_name}{mid} {p.last_name}"
+
+
+def _person(p):
+    return {"id": p.id, "full_name": _full_name(p), "image": p.image}
+
+
+def _ordered(rel, order_model):
+    # NULLS LAST on list_order, then last name: the order the other contenders use.
+    return rel.objects.order_by(
+        order_model.list_order.asc(nulls="last"), order_model.person.last_name
+    ).load(order_model.person)
+
+
+async def _avg_ratings(ids):
+    # load() takes no avg() over a relation column, so a select() gives the average per movie.
+    if not ids:
+        return {}
+    rows = await Movie.objects.filter(Movie.id.in_(list(ids))).select(
+        Movie.id, func.avg(Movie.reviews.rating)
+    )
+    return {r[0]: (float(r[1]) if r[1] is not None else None) for r in rows}
+
+
+async def load_ids(ctx, db):
+    # MonOrm has no func.random(), so the sample is drawn in Python.
+    def pick(ids):
+        return random.sample(ids, min(ctx.number_of_ids, len(ids)))
+
+    users = pick(await User.objects.select(User.id).scalars())
+    movies = pick(await Movie.objects.select(Movie.id).scalars())
+    people = pick(await Person.objects.select(Person.id).scalars())
+    return dict(
+        get_user=users,
+        get_movie=movies,
+        get_person=people,
+        # re-use movie IDs for update tests
+        update_movie=movies,
+        # as many insert stubs as "concurrency" to accommodate concurrent inserts
+        insert_user=[INSERT_PREFIX] * ctx.concurrency,
+        insert_movie=[{"prefix": INSERT_PREFIX, "people": people[:4]}] * ctx.concurrency,
+        insert_movie_plus=[INSERT_PREFIX] * ctx.concurrency,
+    )
+
+
+async def get_user(db, id):
+    user = await User.objects.filter(User.id == id).load(
+        User.reviews.objects.order_by(-Review.creation_time)[:10].load(Review.movie).label("latest")
+    ).first()
+    ratings = await _avg_ratings({r.movie.id for r in user.latest})
+    return json.dumps(
+        {
+            "id": user.id,
+            "name": user.name,
+            "image": user.image,
+            "latest_reviews": [
+                {
+                    "id": r.id,
+                    "body": r.body,
+                    "rating": r.rating,
+                    "movie": {
+                        "id": r.movie.id,
+                        "image": r.movie.image,
+                        "title": r.movie.title,
+                        "avg_rating": ratings[r.movie.id],
+                    },
+                }
+                for r in user.latest
+            ],
+        }
+    )
+
+
+async def get_movie(db, id):
+    movie = await Movie.objects.filter(Movie.id == id).load(
+        _ordered(Movie.directors, Director).label("dirs"),
+        _ordered(Movie.cast, Actor).label("cast_l"),
+        Movie.reviews.objects.order_by(-Review.creation_time).load(Review.author).label("revs"),
+    ).first()
+    ratings = await _avg_ratings({id})
+    return json.dumps(
+        {
+            "id": movie.id,
+            "image": movie.image,
+            "title": movie.title,
+            "year": movie.year,
+            "description": movie.description,
+            "avg_rating": ratings[id],
+            "directors": [_person(d.person) for d in movie.dirs],
+            "cast": [_person(c.person) for c in movie.cast_l],
+            "reviews": [
+                {
+                    "id": r.id,
+                    "body": r.body,
+                    "rating": float(r.rating),
+                    "author": {"id": r.author.id, "name": r.author.name, "image": r.author.image},
+                }
+                for r in movie.revs
+            ],
+        }
+    )
+
+
+async def get_person(db, id):
+    person = await Person.objects.filter(Person.id == id).load(
+        Person.acted_in.objects.order_by(Actor.movie.year, Actor.movie.title).load(Actor.movie).label("acted"),
+        Person.directed.objects.order_by(Director.movie.year, Director.movie.title)
+        .load(Director.movie)
+        .label("dirs"),
+    ).first()
+    ratings = await _avg_ratings({r.movie.id for r in person.acted} | {r.movie.id for r in person.dirs})
+
+    def movies(rels):
+        return [
+            {
+                "id": r.movie.id,
+                "image": r.movie.image,
+                "title": r.movie.title,
+                "year": r.movie.year,
+                "avg_rating": ratings[r.movie.id],
+            }
+            for r in rels
+        ]
+
+    return json.dumps(
+        {
+            "id": person.id,
+            "image": person.image,
+            "full_name": _full_name(person),
+            "bio": person.bio,
+            "acted_in": movies(person.acted),
+            "directed": movies(person.dirs),
+        }
+    )
+
+
+async def update_movie(db, id):
+    rows = (
+        await Movie.objects.filter(Movie.id == id)
+        .update(title=func.concat(Movie.title, f"---{str(id)[:8]}"))
+        .returning()
+    )
+    return json.dumps({"id": rows[0].id, "title": rows[0].title})
+
+
+async def insert_user(db, val):
+    num = random.randrange(1_000_000)
+    user = await User.objects.insert(name=f"{val}{num}", image=f"image_{val}{num}")
+    return json.dumps({"id": user.id, "name": user.name, "image": user.image})
+
+
+async def insert_movie(db, val):
+    num = random.randrange(1_000_000)
+    movie = await Movie.objects.insert(
+        title=f'{val["prefix"]}{num}',
+        image=f'{val["prefix"]}image{num}.jpeg',
+        description=f'{val["prefix"]}description{num}',
+        year=num,
+    )
+    people = await Person.objects.filter(Person.id.in_(val["people"][0:4])).order_by(Person.id)
+    await Director.objects.insert(person_id=people[0].id, movie_id=movie.id)
+    await Actor.objects.insert_many([{"person_id": p.id, "movie_id": movie.id} for p in people[1:4]])
+    return json.dumps(
+        {
+            "id": movie.id,
+            "image": movie.image,
+            "title": movie.title,
+            "year": movie.year,
+            "description": movie.description,
+            "directors": [_person(people[0])],
+            "cast": [_person(p) for p in people[1:4]],
+        }
+    )
+
+
+async def insert_movie_plus(db, val):
+    num = random.randrange(1_000_000)
+
+    def person(first, last, n):
+        return dict(first_name=f"{val}{first}", middle_name="", last_name=f"{val}{last}",
+                    image=f"{val}image{n}.jpeg", bio="")
+
+    director, c0, c1 = await Person.objects.insert_many(
+        [person("Alice", "Director", num), person("Billie", "Actor", num + 1), person("Cameron", "Actor", num + 2)]
+    ).returning()
+    movie = await Movie.objects.insert(
+        title=f"{val}{num}",
+        image=f"{val}image{num}.jpeg",
+        description=f"{val}description{num}",
+        year=num,
+    )
+    await Director.objects.insert(person_id=director.id, movie_id=movie.id)
+    await Actor.objects.insert_many([{"person_id": c.id, "movie_id": movie.id} for c in (c0, c1)])
+    return json.dumps(
+        {
+            "id": movie.id,
+            "image": movie.image,
+            "title": movie.title,
+            "year": movie.year,
+            "description": movie.description,
+            "directors": [_person(director)],
+            "cast": [_person(c0), _person(c1)],
+        }
+    )
+
+
+async def setup(ctx, db, queryname):
+    if queryname == "update_movie":
+        # MonOrm has no split_part, so each suffixed title loses its own "---<id>" parts.
+        rows = await Movie.objects.filter(Movie.title.contains("---")).select(Movie.id)
+        async with db.transaction():
+            for (mid,) in rows:
+                await Movie.objects.filter(Movie.id == mid).update(
+                    title=func.replace(Movie.title, f"---{str(mid)[:8]}", "")
+                )
+    elif queryname == "insert_user":
+        await User.objects.filter(User.name.startswith(INSERT_PREFIX)).delete()
+    elif queryname in {"insert_movie", "insert_movie_plus"}:
+        async with db.transaction():
+            await Director.objects.filter(Director.movie.image.startswith(INSERT_PREFIX)).delete()
+            await Actor.objects.filter(Actor.movie.image.startswith(INSERT_PREFIX)).delete()
+            await Movie.objects.filter(Movie.image.startswith(INSERT_PREFIX)).delete()
+            await Person.objects.filter(Person.image.startswith(INSERT_PREFIX)).delete()
+
+
+async def cleanup(ctx, db, queryname):
+    if queryname in {"update_movie", "insert_user", "insert_movie", "insert_movie_plus"}:
+        await setup(ctx, db, queryname)
