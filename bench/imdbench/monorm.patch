+"""Write a small protodataset.json, for runs where `synth` is not installed.
+
+Run it, then run `dataset/cleandata.py` to get `dataset.json` as usual.
+"""
+import datetime
+import json
+import pathlib
+import random
+
+N_USERS, N_DIRECTORS, N_PEOPLE, N_MOVIES, N_REVIEWS = 60, 20, 150, 40, 400
+
+rnd = random.Random(1)
+build = pathlib.Path(__file__).resolve().parents[2] / 'dataset' / 'build'
+build.mkdir(exist_ok=True)
+
+
+def person(i):
+    return {
+        'id': i,
+        'first_name': f'First{i}',
+        'middle_name': f'Mid{i}' if i % 3 == 0 else None,
+        'last_name': f'Last{rnd.randrange(30)}',
+        'image': f'person{i}.jpeg',
+        'bio': f'Bio of person {i}',
+    }
+
+
+people = [person(i) for i in range(N_PEOPLE)]
+data = {
+    'user': [
+        {'id': i, 'name': f'User{i}', 'image': f'user{i}.jpeg'}
+        for i in range(N_USERS)
+    ],
+    'director': people[:N_DIRECTORS],
+    'person': people,
+    'movie': [
+        {
+            'id': i,
+            'image': f'movie{i}.jpeg',
+            'title': f'Movie {i}',
+            'year': 1980 + i % 40,
+            'description': f'Description of movie {i}',
+            'directors': rnd.sample(range(N_DIRECTORS), rnd.randint(1, 2)),
+            'cast': rnd.sample(range(N_DIRECTORS, N_PEOPLE), rnd.randint(3, 8)),
+        }
+        for i in range(N_MOVIES)
+    ],
+}
+t0 = datetime.datetime(2020, 1, 1, tzinfo=datetime.timezone.utc)
+data['review'] = [
+    {
+        'id': i,
+        'body': f'Review {i}',
+        'rating': rnd.randint(1, 5),
+        # Distinct times keep the "latest reviews" order deterministic.
+        'creation_time': (t0 + datetime.timedelta(minutes=i)).isoformat(),
+        'author': rnd.randrange(N_USERS),
+        'movie': rnd.randrange(N_MOVIES),
+    }
+    for i in range(N_REVIEWS)
+]
+(build / 'protodataset.json').write_text(json.dumps(data))
