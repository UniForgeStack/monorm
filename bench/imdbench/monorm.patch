diff --git a/_monorm/index.mjs b/_monorm/index.mjs
new file mode 100644
index 0000000..5034128
--- /dev/null
+++ b/_monorm/index.mjs
@@ -0,0 +1,285 @@
+import { readFileSync } from "node:fs";
+import { connect, func, loads } from "./orm.mjs";
+
+const INSERT_PREFIX = "insert_test__";
+
+const models = loads(readFileSync(new URL("./schema.prisma", import.meta.url), "utf8"));
+const { Movie, Person, User, Director, Actor, Review } = models;
+
+function fullName(p) {
+  return p.middleName ? `${p.firstName} ${p.middleName} ${p.lastName}` : `${p.firstName} ${p.lastName}`;
+}
+
+function person(p) {
+  return { id: p.id, full_name: fullName(p), image: p.image };
+}
+
+// NULLS LAST on list_order, then last name: the order the other contenders use.
+function ordered(rel, orderModel) {
+  return rel.objects
+    .orderBy(orderModel.listOrder.asc({ nulls: "last" }), orderModel.person.lastName)
+    .load(orderModel.person);
+}
+
+function shuffle(a) {
+  for (let i = a.length - 1; i > 0; i--) {
+    const j = Math.floor(Math.random() * (i + 1));
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
+
+export class App {
+  constructor({ host, port, max }) {
+    // The default matches the database of the `_postgres` contenders; the env var points a local run elsewhere.
+    this.url =
+      process.env.IMDBENCH_MONORM_URL ||
+      `postgres://postgres_bench:edgedbbenchmark@${host}:${port}/postgres_bench`;
+    this.max = max;
+  }
+
+  async init() {
+    this.db = await connect(this.url, { maxConnections: this.max });
+  }
+
+  async close() {
+    await this.db.close();
+  }
+
+  getConnection(i) {
+    return this;
+  }
+
+  // load() takes no avg() over a relation column, so a select() gives the average per movie.
+  async avgRatings(ids) {
+    const out = new Map();
+    if (ids.length === 0) return out;
+    const rows = await Movie.objects
+      .filter(Movie.id.in(ids))
+      .select({ id: Movie.id, avg: func.avg(Movie.reviews.rating) });
+    for (const r of rows) out.set(r.id, r.avg === null ? null : Number(r.avg));
+    return out;
+  }
+
+  async userDetails(id) {
+    const user = await User.objects
+      .filter(User.id.eq(id))
+      .load(
+        User.reviews.objects.orderBy(Review.creationTime.desc()).limit(10).load(Review.movie).label("latest"),
+      )
+      .first();
+    const ratings = await this.avgRatings([...new Set(user.latest.map((r) => r.movie.id))]);
+    return JSON.stringify({
+      id: user.id,
+      name: user.name,
+      image: user.image,
+      latest_reviews: user.latest.map((r) => ({
+        id: r.id,
+        body: r.body,
+        rating: r.rating,
+        movie: {
+          id: r.movie.id,
+          image: r.movie.image,
+          title: r.movie.title,
+          avg_rating: ratings.get(r.movie.id),
+        },
+      })),
+    });
+  }
+
+  async movieDetails(id) {
+    const movie = await Movie.objects
+      .filter(Movie.id.eq(id))
+      .load(
+        ordered(Movie.directors, Director).label("dirs"),
+        ordered(Movie.cast, Actor).label("castList"),
+        Movie.reviews.objects.orderBy(Review.creationTime.desc()).load(Review.author).label("revs"),
+      )
+      .first();
+    const ratings = await this.avgRatings([id]);
+    return JSON.stringify({
+      id: movie.id,
+      image: movie.image,
+      title: movie.title,
+      year: movie.year,
+      description: movie.description,
+      avg_rating: ratings.get(id),
+      directors: movie.dirs.map((d) => person(d.person)),
+      cast: movie.castList.map((c) => person(c.person)),
+      reviews: movie.revs.map((r) => ({
+        id: r.id,
+        body: r.body,
+        rating: r.rating,
+        author: { id: r.author.id, name: r.author.name, image: r.author.image },
+      })),
+    });
+  }
+
+  async personDetails(id) {
+    const p = await Person.objects
+      .filter(Person.id.eq(id))
+      .load(
+        Person.actedIn.objects.orderBy(Actor.movie.year, Actor.movie.title).load(Actor.movie).label("acted"),
+        Person.directed.objects
+          .orderBy(Director.movie.year, Director.movie.title)
+          .load(Director.movie)
+          .label("dirs"),
+      )
+      .first();
+    const ids = [...new Set([...p.acted, ...p.dirs].map((r) => r.movie.id))];
+    const ratings = await this.avgRatings(ids);
+    const movies = (rels) =>
+      rels.map((r) => ({
+        id: r.movie.id,
+        image: r.movie.image,
+        title: r.movie.title,
+        year: r.movie.year,
+        avg_rating: ratings.get(r.movie.id),
+      }));
+    return JSON.stringify({
+      id: p.id,
+      image: p.image,
+      full_name: fullName(p),
+      bio: p.bio,
+      acted_in: movies(p.acted),
+      directed: movies(p.dirs),
+    });
+  }
+
+  async updateMovie(id) {
+    const [row] = await Movie.objects
+      .filter(Movie.id.eq(id))
+      .update({ title: func.concat(Movie.title, `---${String(id).slice(0, 8)}`) }, { returning: true });
+    return JSON.stringify({ id: row.id, title: row.title });
+  }
+
+  async insertUser(val) {
+    const num = Math.floor(Math.random() * 1_000_000);
+    const user = await User.objects.insert({ name: `${val}${num}`, image: `image_${val}${num}` });
+    return JSON.stringify({ id: user.id, name: user.name, image: user.image });
+  }
+
+  async insertMovie(val) {
+    const num = Math.floor(Math.random() * 1_000_000);
+    const movie = await Movie.objects.insert({
+      title: `${val.prefix}${num}`,
+      image: `${val.prefix}image${num}.jpeg`,
+      description: `${val.prefix}description${num}`,
+      year: num,
+    });
+    const people = await Person.objects.filter(Person.id.in(val.people.slice(0, 4))).orderBy(Person.id);
+    await Director.objects.insert({ personId: people[0].id, movieId: movie.id });
+    await Actor.objects.insertMany(people.slice(1, 4).map((p) => ({ personId: p.id, movieId: movie.id })));
+    return JSON.stringify({
+      id: movie.id,
+      image: movie.image,
+      title: movie.title,
+      year: movie.year,
+      description: movie.description,
+      directors: [person(people[0])],
+      cast: people.slice(1, 4).map(person),
+    });
+  }
+
+  async insertMoviePlus(val) {
+    const num = Math.floor(Math.random() * 1_000_000);
+    const mk = (first, last, n) => ({
+      firstName: `${val}${first}`,
+      middleName: "",
+      lastName: `${val}${last}`,
+      image: `${val}image${n}.jpeg`,
+      bio: "",
+    });
+    const [director, c0, c1] = await Person.objects
+      .insertMany([mk("Alice", "Director", num), mk("Billie", "Actor", num + 1), mk("Cameron", "Actor", num + 2)])
+      .returning();
+    const movie = await Movie.objects.insert({
+      title: `${val}${num}`,
+      image: `${val}image${num}.jpeg`,
+      description: `${val}description${num}`,
+      year: num,
+    });
+    await Director.objects.insert({ personId: director.id, movieId: movie.id });
+    await Actor.objects.insertMany([c0, c1].map((c) => ({ personId: c.id, movieId: movie.id })));
+    return JSON.stringify({
+      id: movie.id,
+      image: movie.image,
+      title: movie.title,
+      year: movie.year,
+      description: movie.description,
+      directors: [person(director)],
+      cast: [person(c0), person(c1)],
+    });
+  }
+
+  async benchQuery(query, id) {
+    switch (query) {
+      case "get_user":
+        return this.userDetails(id);
+      case "get_person":
+        return this.personDetails(id);
+      case "get_movie":
+        return this.movieDetails(id);
+      case "update_movie":
+        return this.updateMovie(id);
+      case "insert_user":
+        return this.insertUser(id);
+      case "insert_movie":
+        return this.insertMovie(id);
+      case "insert_movie_plus":
+        return this.insertMoviePlus(id);
+    }
+  }
+
+  async getIDs(n) {
+    // MonOrm has no func.random(), so the sample is drawn in JS.
+    const pick = (ids) => shuffle(ids).slice(0, n);
+    const [users, people, movies] = await Promise.all([
+      User.objects.select({ id: User.id }).scalars(),
+      Person.objects.select({ id: Person.id }).scalars(),
+      Movie.objects.select({ id: Movie.id }).scalars(),
+    ]);
+    const picked = { users: pick(users), people: pick(people), movies: pick(movies) };
+    return {
+      get_user: picked.users,
+      get_person: picked.people,
+      get_movie: picked.movies,
+      // re-use movie IDs for update tests
+      update_movie: picked.movies,
+      // generate a bunch of insert stubs to accommodate concurrent inserts
+      insert_user: Array(1000).fill(INSERT_PREFIX),
+      insert_movie: Array(1000).fill({ prefix: INSERT_PREFIX, people: picked.people.slice(0, 4) }),
+      insert_movie_plus: Array(1000).fill(INSERT_PREFIX),
+    };
+  }
+
+  async setup(query) {
+    if (query === "update_movie") {
+      // MonOrm has no split_part, so each suffixed title loses its own "---<id>" part.
+      const ids = await Movie.objects.filter(Movie.title.contains("---")).select({ id: Movie.id }).scalars();
+      await this.db.transaction(async () => {
+        for (const id of ids) {
+          await Movie.objects
+            .filter(Movie.id.eq(id))
+            .update({ title: func.replace(Movie.title, `---${String(id).slice(0, 8)}`, "") });
+        }
+      });
+    } else if (query === "insert_user") {
+      await User.objects.filter(User.name.startsWith(INSERT_PREFIX)).delete();
+    } else if (query === "insert_movie" || query === "insert_movie_plus") {
+      await this.db.transaction(async () => {
+        await Director.objects.filter(Director.movie.image.startsWith(INSERT_PREFIX)).delete();
+        await Actor.objects.filter(Actor.movie.image.startsWith(INSERT_PREFIX)).delete();
+        await Movie.objects.filter(Movie.image.startsWith(INSERT_PREFIX)).delete();
+        await Person.objects.filter(Person.image.startsWith(INSERT_PREFIX)).delete();
+      });
+    }
+  }
+
+  async cleanup(query) {
+    if (["update_movie", "insert_user", "insert_movie", "insert_movie_plus"].includes(query)) {
+      // The clean up is the same as setup for mutation benchmarks
+      await this.setup(query);
+    }
+  }
+}
