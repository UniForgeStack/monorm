{
  "name": "monorm-admin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The browser UI of the admin service. `npm run build` writes `dist/`, which `monorm-admin` embeds.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "8.21.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
