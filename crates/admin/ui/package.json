{
  "name": "monorm-admin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The browser UI of the admin service. `npm run build` writes `dist/`, which `monorm-admin` embeds.",
  "scripts": {
    "build": "node scripts/shared.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "test": "node --test test/*.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
