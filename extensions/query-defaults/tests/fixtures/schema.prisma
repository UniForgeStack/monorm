datasource db { provider = "sqlite" }
model Policy {
  id Int @id @default(autoincrement())
  active Boolean @default(true)
  name String
  bio String @query.selectOut
  @@query.defaults(filter: "active == true", fields: ["id", "name"])
}
model Scoped {
  id      Int @id @default(autoincrement())
  shop_id Int
  @@query.filter("tenant", "shop_id == scope.shop")
}
model Notice {
  id        Int     @id @default(autoincrement())
  owner     Int
  published Boolean
  @@query.filter("mine", "owner == 1")
  @@query.filter("published", "published == true")
}
model Draft {
  id        Int     @id @default(autoincrement())
  owner     Int
  published Boolean
  @@query.parent("Notice")
  @@query.filter("published", "published == false")
}
model Archive {
  id        Int     @id @default(autoincrement())
  owner     Int
  published Boolean
  @@query.parent("Notice")
  @@query.filter("published", "none")
}
