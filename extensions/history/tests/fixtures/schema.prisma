datasource db {
  provider = "sqlite"
}

model Post {
  id    Int     @id @default(autoincrement())
  title String
  body  String?
  views Int     @default(0)

  @@history.track
  @@map("hx_pub_posts")
}

model BundleVersion {
  id        Int @id @default(autoincrement())
  bundle_id Int

  @@history.versions(of: bundle_id)
  @@map("hx_pub_bundle_versions")
}
