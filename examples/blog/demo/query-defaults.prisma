// Needs the orm-query-defaults package.

model Article {
  id         Int      @id @default(autoincrement())
  title      String
  body       String   @query.selectOut
  visible    Boolean  @default(true)
  created_at DateTime @default(now())
  @@query.filter("visible", "visible == true")
  @@query.order("-created_at", "id")
  @@map("demo_articles")
}
