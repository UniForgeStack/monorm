// Needs the generic extension (Python: monorm-generic; the npm package monorm bundles it). `monorm identities` freezes the
// ContentType values into generic-relations.identities.json first.

model Photo {
  id   Int        @id
  url  String
  tags Label[]    @generic.reverse
  @@map("demo_photos")
}

model Video {
  id    Int     @id
  title String
  tags  Label[] @generic.reverse
  @@map("demo_videos")
}

model Label {
  id     Int      @id
  name   String
  target Generic? @generic.relation(targets: ["Photo", "Video"])
  @@map("demo_labels")
}
