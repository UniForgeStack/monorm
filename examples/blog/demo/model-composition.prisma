// Needs the orm-composition package (@@composition.model).

model Person {
  id   Int    @id @default(autoincrement())
  name String
  @@map("demo_people")
}

model Employee {
  salary Int
  @@composition.model(parent: "Person", parentRef: "person", childRef: "employee")
  @@map("demo_employees")
}

model Customer {
  points Int
  @@composition.model(parent: "Person", parentRef: "person", childRef: "customer")
  @@map("demo_customers")
}
