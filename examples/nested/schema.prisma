// Source of truth for examples/nested: nested value types on both storages.
// models.py / models.pyi / models.ts next to this file are generated from it.

datasource db {
  provider = "postgresql"
}

type Geo {
  lat Float
  lng Float?
}

type Address {
  city   String
  floor  Int @default(7)
  big    BigInt
  opened DateTime
  geo    Geo?
}

type Wrap {
  inner Geo?
}

type Tagged {
  tag   String
  inner Geo?
}

model Shop {
  id       Int      @id
  address  Address?
  snapshot Address  @storage(json)
}

model Plain {
  id Int @id
  g  Geo
}

model Wrapped {
  id Int  @id
  w  Wrap
}

model Opt {
  id Int     @id
  t  Tagged?
}
