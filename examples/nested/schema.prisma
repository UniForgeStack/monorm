// Source of truth for examples/nested: nested value types on both storages.
// Slugged and Titled hold the unique indexes that the typing checks read as `Model.indexes`.
// models.py / models.pyi / models.ts next to this file are generated from it.

datasource db {
  provider = "postgresql"
}

type Geo {
  lat Float
  lng Float?
}

type Address {
  city   String
  floor  Int @default(7)
  big    BigInt
  opened DateTime
  geo    Geo?
}

type Wrap {
  inner Geo?
}

type Tagged {
  tag   String
  inner Geo?
}

model Shop {
  id       Int      @id
  address  Address?
  snapshot Address  @storage(json)
}

model Plain {
  id Int @id
  g  Geo
}

model Wrapped {
  id Int  @id
  w  Wrap
}

model Opt {
  id Int     @id
  t  Tagged?
}

model Slugged {
  id   Int    @id
  slug String
  @@index([slug], unique: true, map: "slugged_slug")
  @@index([slug, id], unique: true, map: "slugged_slug_id")
  @@index([id])
}

model Titled {
  id    Int    @id
  title String
  @@index([title], unique: true, map: "titled_title")
}
