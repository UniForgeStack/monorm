{
  "name": "monorm",
  "version": "0.1.0",
  "description": "The same package as @ufstack/monorm: TypeScript ORM with a Rust core",
  "license": "MIT",
  "author": "mh-alahdadi <mhalah15@gmail.com> (https://github.com/mh-alahdadi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniForgeStack/monorm.git",
    "directory": "languages/js/unscoped"
  },
  "bugs": {
    "url": "https://github.com/UniForgeStack/monorm/issues"
  },
  "homepage": "https://github.com/UniForgeStack/monorm#readme",
  "keywords": [
    "orm",
    "typescript",
    "rust",
    "postgresql",
    "sqlite",
    "monorm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ext": {
      "types": "./src/ext.d.ts",
      "default": "./src/ext.js"
    },
    "./otel": {
      "types": "./src/otel.d.ts",
      "default": "./src/otel.js"
    }
  },
  "bin": {
    "monorm": "./src/cli.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "@ufstack/monorm": "0.1.0"
  }
}
