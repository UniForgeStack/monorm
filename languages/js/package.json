{
  "name": "orm",
  "version": "0.1.0",
  "description": "TypeScript ORM with a Rust core: the same engine and schema as the Python package",
  "license": "MIT",
  "author": "mh-alahdadi <mhalah15@gmail.com> (https://github.com/mh-alahdadi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniForgeStack/monorm.git",
    "directory": "languages/js"
  },
  "bugs": {
    "url": "https://github.com/UniForgeStack/monorm/issues"
  },
  "homepage": "https://github.com/UniForgeStack/monorm#readme",
  "keywords": [
    "orm",
    "typescript",
    "rust",
    "postgresql",
    "sqlite",
    "prisma",
    "migrations",
    "napi"
  ],
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./ext": {
      "types": "./dist/src/ext.d.ts",
      "default": "./dist/src/ext.js"
    },
    "./otel": {
      "types": "./dist/src/otel.d.ts",
      "default": "./dist/src/otel.js"
    }
  },
  "bin": {
    "orm": "./dist/src/cli.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/typing/tsconfig.json --noEmit",
    "test": "npm run build && node --expose-gc --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "test:bun": "npm run build && bun test --timeout 300000 ./dist/test/"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "import-meta-resolve": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "@orm/timestamps": "file:../../target/extension-packages/timestamps/npm",
    "@orm/soft-delete": "file:../../target/extension-packages/soft-delete/npm",
    "@orm/locking": "file:../../target/extension-packages/locking/npm",
    "@orm/inherit": "file:../../target/extension-packages/inherit/npm",
    "@orm/query-defaults": "file:../../target/extension-packages/query-defaults/npm",
    "@orm/generic": "file:../../target/extension-packages/generic/npm",
    "@orm/proxy": "file:../../target/extension-packages/proxy/npm",
    "@orm/composition": "file:../../target/extension-packages/model-composition/npm",
    "@orm/file-storage": "file:../../target/extension-packages/file-storage/npm",
    "opendal": "^0.49.0"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "peerDependencies": {
    "@orm/native-postgres": "0.1.0",
    "@orm/native-sqlite": "0.1.0",
    "@orm/native-combined": "0.1.0",
    "@orm/native-tooling": "0.1.0",
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@orm/native-postgres": {
      "optional": true
    },
    "@orm/native-sqlite": {
      "optional": true
    },
    "@orm/native-combined": {
      "optional": true
    },
    "@orm/native-tooling": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
