{
  "name": "monorm",
  "version": "0.1.0",
  "description": "TypeScript ORM with a Rust core: the same engine and schema as the Python package",
  "license": "MIT",
  "author": "mh-alahdadi <mhalah15@gmail.com> (https://github.com/mh-alahdadi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniForgeStack/monorm.git",
    "directory": "languages/js"
  },
  "bugs": {
    "url": "https://github.com/UniForgeStack/monorm/issues"
  },
  "homepage": "https://github.com/UniForgeStack/monorm#readme",
  "keywords": [
    "orm",
    "typescript",
    "rust",
    "postgresql",
    "sqlite",
    "prisma",
    "migrations",
    "napi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./ext": {
      "types": "./dist/src/ext.d.ts",
      "default": "./dist/src/ext.js"
    },
    "./otel": {
      "types": "./dist/src/otel.d.ts",
      "default": "./dist/src/otel.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "default": "./dist/src/cli.js"
    },
    "./extensions/timestamps": {
      "types": "./extensions/timestamps/index.d.ts",
      "default": "./extensions/timestamps/index.js"
    },
    "./extensions/soft-delete": {
      "types": "./extensions/soft-delete/index.d.ts",
      "default": "./extensions/soft-delete/index.js"
    },
    "./extensions/locking": {
      "types": "./extensions/locking/index.d.ts",
      "default": "./extensions/locking/index.js"
    },
    "./extensions/inherit": {
      "types": "./extensions/inherit/index.d.ts",
      "default": "./extensions/inherit/index.js"
    },
    "./extensions/query-defaults": {
      "types": "./extensions/query-defaults/index.d.ts",
      "default": "./extensions/query-defaults/index.js"
    },
    "./extensions/generic": {
      "types": "./extensions/generic/index.d.ts",
      "default": "./extensions/generic/index.js"
    },
    "./extensions/proxy": {
      "types": "./extensions/proxy/index.d.ts",
      "default": "./extensions/proxy/index.js"
    },
    "./extensions/model-composition": {
      "types": "./extensions/model-composition/index.d.ts",
      "default": "./extensions/model-composition/index.js"
    },
    "./extensions/file-storage": {
      "types": "./extensions/file-storage/index.d.ts",
      "default": "./extensions/file-storage/index.js"
    },
    "./extensions/file-storage/decoder": {
      "types": "./extensions/file-storage/decoder.d.ts",
      "default": "./extensions/file-storage/decoder.js"
    },
    "./extensions/file-storage/model": {
      "types": "./extensions/file-storage/model.d.ts",
      "default": "./extensions/file-storage/model.js"
    },
    "./auth": {
      "types": "./dist/src/auth/index.d.ts",
      "default": "./dist/src/auth/index.js"
    },
    "./auth/queries.js": {
      "types": "./dist/src/auth/queries.d.ts",
      "default": "./dist/src/auth/queries.js"
    },
    "./auth/methods.js": {
      "types": "./dist/src/auth/methods.d.ts",
      "default": "./dist/src/auth/methods.js"
    },
    "./auth/schema.prisma": "./auth/schema.prisma",
    "./package.json": "./package.json"
  },
  "bin": {
    "monorm": "./dist/src/cli.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "monorm": {
    "bundled": {
      "extensions": {
        "monorm.timestamps": "extensions/timestamps",
        "monorm.soft-delete": "extensions/soft-delete",
        "monorm.locking": "extensions/locking",
        "monorm.inherit": "extensions/inherit",
        "monorm.query-defaults": "extensions/query-defaults",
        "monorm.generic": "extensions/generic",
        "monorm.proxy": "extensions/proxy",
        "monorm.composition": "extensions/model-composition",
        "monorm.file-storage": "extensions/file-storage"
      },
      "apps": {
        "auth": "auth/schema.prisma"
      }
    }
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "assemble": "node scripts/assemble-bundle.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build && node scripts/assemble-bundle.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/typing/tsconfig.json --noEmit",
    "test": "npm run build && node --expose-gc --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "test:bun": "npm run build && bun test --timeout 300000 ./dist/test/"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.0",
    "decimal.js": "^10.4.3",
    "import-meta-resolve": "^4.2.0",
    "opendal": "^0.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist/src",
    "prebuilt",
    "extensions",
    "auth",
    "README.md"
  ],
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
