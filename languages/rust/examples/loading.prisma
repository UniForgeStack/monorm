model PolicyAuthor {
 id Int @id
 name String
 bio String
 note String?
 visible Boolean
 books PolicyBook[] @relation("Books")
 edited PolicyBook[] @relation("Edited")
 @@map("rust_load_authors")
}
model PolicyBook {
 id Int @id
 author_id Int
 editor_id Int?
 title String
 author PolicyAuthor @relation("Books", fields: [author_id], references: [id])
 editor PolicyAuthor? @relation("Edited", fields: [editor_id], references: [id])
 @@map("rust_load_books")
}
model OrderedAuthor {
 id Int @id
 name String
 visible Boolean
 @@map("rust_load_ordered_authors")
}
model CompositeOwner {
 tenant Int
 id Int
 name String
 children CompositeChild[]
 @@id([tenant, id])
 @@map("rust_load_composite_owners")
}
model CompositeChild {
 id Int @id
 owner_tenant Int?
 owner_id Int?
 title String
 owner CompositeOwner? @relation(fields: [owner_tenant, owner_id], references: [tenant, id])
 @@map("rust_load_composite_children")
}
model ProjectionPerson {
 id Int @id
 account ProjectionAccount?
 @@map("rust_projection_people")
}
model ProjectionAccount {
 id Int @id
 person_id Int @unique
 code String
 person ProjectionPerson @relation(fields: [person_id], references: [id])
 @@map("rust_projection_accounts")
}
